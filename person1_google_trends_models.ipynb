    "\n",
    "for h in HORIZONS:\n",
    "    t = test_all[test_all[\"horizon\"] == h].set_index(\"model\")\n",
    "    best_simple = t.loc[[\"ets\", \"ridge\", \"lasso\"]].dropna(subset=[\"mae\"])[\"mae\"].idxmin() if RUN_ETS else t.loc[[\"ridge\", \"lasso\"], \"mae\"].idxmin()\n",
    "    best_base = t.loc[[\"last_value\", \"avg_4w\", \"seasonal_naive\"], \"mae\"].idxmin()\n",
    "    gain = 1 - t.loc[best_simple, \"mae\"] / t.loc[best_base, \"mae\"]\n",
    "    print(f\"Horizon {h}: best baseline = {best_base} (MAE {t.loc[best_base, 'mae']:.2f}); \"\n",
    "          f\"best simpler model = {best_simple} (MAE {t.loc[best_simple, 'mae']:.2f}, \"\n",
    "          f\"{gain:+.1%} vs. the best baseline, MASE {t.loc[best_simple, 'mase']:.2f})\")\n",
    "    for scope, label in [(\"no_spike\", \"without spike weeks\"), (\"no_spike_window\", \"without spike weeks and their look-back\")]:\n",
    "        ns = scores[(scores[\"period\"] == \"test\") & (scores[\"scope\"] == scope) & (scores[\"horizon\"] == h)].set_index(\"model\")\n",
    "        if len(ns):\n",
    "            print(f\"           {label}: best simpler model MAE {ns.loc[best_simple, 'mae']:.2f} \"\n",
    "                  f\"vs. best baseline {ns.loc[best_base, 'mae']:.2f}\")\n",
