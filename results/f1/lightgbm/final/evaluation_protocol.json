{
  "model": "lightgbm_seasonal_correction",
  "target": "single_week_popularity",
  "horizons_weeks": [
    4,
    8
  ],
  "series_count": 10000,
  "test_target_start": "2019-04-01",
  "test_target_end": "2019-12-30",
  "test_target_weeks": 40,
  "refit_every_forecast_weeks": 4,
