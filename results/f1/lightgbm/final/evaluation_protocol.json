  "clip_forecasts_at_zero": true,
  "with_influencer_versions": [
    "no",
    "yes"
  ],
  "parameters_by_horizon": {
    "4": {
      "objective": "regression_l1",
      "n_estimators": 1000,
      "learning_rate": 0.03,
      "num_leaves": 15,
      "max_depth": 5,
      "min_child_samples": 200,
      "reg_lambda": 10.0,
      "random_state": 42,
      "n_jobs": 4,
      "verbosity": -1
    },
    "8": {
      "objective": "regression_l1",
      "n_estimators": 1000,
      "learning_rate": 0.03,
      "num_leaves": 15,
      "max_depth": 5,
      "min_child_samples": 200,
      "reg_lambda": 10.0,
      "random_state": 42,
      "n_jobs": 4,
      "verbosity": -1
    }
  },
  "metrics": [
    "mae",
    "mase_train_m1",
    "relative_mae_vs_four_week_average"
  ],
  "bootstrap_block_lengths_weeks": [
    4,
    8,
    13
  ],
  "bootstrap_repeats": 5000
